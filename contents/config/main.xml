<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
    <kcfgfile name=""/>

    <group name="General">
        <entry name="useCustomFont" type="Bool">
            <default>false</default>
        </entry>
        <entry name="customFont" type="Font">
            <default></default>
        </entry>
        <entry name="volumeStep" type="Int">
            <default>5</default>
        </entry>
        <entry name="desktopWidgetBg" type="Int">
            <default>1</default>
        </entry>
        <entry name="albumPlaceholder" type="String">
            <default></default>
        </entry>
        <entry name="fillAvailableSpace" type="Bool">
            <default>false</default>
        </entry>
        <entry name="hidePlayerControlBindsInHoverTooltip" type="Bool">
            <default>false</default>
        </entry>
        <entry name="fullTitlePosition" type="Int">
            <default>1</default>
        </entry>
        <entry name="fullViewTextScrollingSpeed" type="Int">
            <default>3</default>
        </entry>
        <entry name="fullArtistsPosition" type="Int">
            <default>2</default>
        </entry>
        <entry name="fullAlbumPosition" type="Int">
            <default>2</default>
        </entry>
        <entry name="fullHideAlbumForSingles" type="Bool">
            <default>false</default>
        </entry>
        <entry name="fullAlbumCoverAsBackground" type="Bool">
            <default>false</default>
        </entry>
        <entry name="fullViewThumbnailVisible" type="Bool">
            <default>true</default>
        </entry>
        <entry name="fullViewProgressBarVisible" type="Bool">
            <default>true</default>
        </entry>
        <entry name="fullViewVolumeControlVisible" type="Bool">
            <default>true</default>
        </entry>
        <entry name="fullViewShuffleVisible" type="Bool">
            <default>true</default>
        </entry>
        <entry name="fullViewPlaybackControlsVisible" type="Bool">
            <default>true</default>
        </entry>
        <entry name="fullViewLoopVisible" type="Bool">
            <default>true</default>
        </entry>
        <entry name="fullViewPlaybackControlsFillWidth" type="Bool">
            <default>true</default>
        </entry>
        <entry name="fullViewSongTextVisible" type="Bool">
            <default>true</default>
        </entry>
        <entry name="fullViewSongTextAlignment" type="Int">
            <default>4</default>
        </entry>
        <entry name="fullViewSongTextPosition" type="Int">
            <default>1</default>
        </entry>
        <entry name="fullViewMinWidth" type="Int">
            <default>100</default>
        </entry>
        <entry name="fullViewMaxWidth" type="Int">
            <default>300</default>
        </entry>
        <entry name="fullAlbumCoverRounded" type="Bool">
            <default>true</default>
        </entry>
        <entry name="fullAlbumCoverRadius" type="Int">
            <default>6</default>
        </entry>
        <entry name="noMediaText" type="String">
            <default>No media found</default>
        </entry>
        <entry name="showWhenNoMedia" type="Bool">
            <default>False</default>
        </entry>

        <!-- SPlayer WebSocket settings -->
        <entry name="wsUrl" type="String">
            <default>ws://localhost:25885</default>
        </entry>
        <entry name="wsReconnectIntervalMs" type="Int">
            <default>3000</default>
        </entry>
        <entry name="fixedWidth" type="Int">
            <default>0</default>
        </entry>
        <entry name="fixedHeight" type="Int">
            <default>0</default>
        </entry>
        <entry name="fontSize" type="Int">
            <default>12</default>
        </entry>
        <entry name="fontFamily" type="String">
            <default></default>
        </entry>
        <entry name="textAlign" type="String">
            <default>center</default>
        </entry>
        <entry name="showBackground" type="Bool">
            <default>true</default>
        </entry>
        <entry name="translationFontSize" type="Int">
            <default>0</default>
        </entry>
        <entry name="lineSpacing" type="Int">
            <default>0</default>
        </entry>
        <entry name="animationType" type="String">
            <default>scale</default>
        </entry>
        <entry name="useCustomColors" type="Bool">
            <default>false</default>
        </entry>
        <entry name="customPlayedColor" type="Color">
            <default>#3daee9</default>
        </entry>
        <entry name="customUnplayedColor" type="Color">
            <default>#eff0f1</default>
        </entry>
        <entry name="showTranslation" type="Bool">
            <default>true</default>
        </entry>
        <entry name="autoHideDelay" type="Int">
            <default>0</default>
        </entry>
        <entry name="showCover" type="Bool">
            <default>true</default>
        </entry>
        <entry name="coverAlign" type="String">
            <default>left</default>
        </entry>
        <entry name="coverSize" type="Int">
            <default>24</default>
        </entry>
        <entry name="coverRadius" type="Int">
            <default>2</default>
        </entry>
    </group>
</kcfg>
